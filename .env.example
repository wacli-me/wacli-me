# OpenAI Secure MCP Tunnel runtime credentials.
# CONTROL_PLANE_API_KEY needs Tunnels Read + Use.
CONTROL_PLANE_TUNNEL_ID=''
CONTROL_PLANE_API_KEY=''

# Bearer token of the one wacli-me tenant exposed by this tunnel.
# Use the same value as that tenant's "token" in config/tenants.json.
WACLI_ME_TENANT_TOKEN=''

# Tenants created through /connect use the self-hosted plan in this Compose setup.
WACLI_ME_DEFAULT_PLAN=self-hosted

# Bind-mounted data is written by the container process. On Linux, set these
# to the values from `id -u` and `id -g` so the files stay editable by you.
WACLI_UID=10001
WACLI_GID=10001

# Connect only while an MCP tool request is being handled. Use "continuous"
# for a permanently synced WhatsApp session. The quiet presence mode is used
# during sync so the linked device does not announce itself as available.
WACLI_SYNC_MODE=on-request
# Keep the connection warm briefly for back-to-back tool calls; 0 disconnects
# as soon as the active request finishes.
WACLI_SYNC_IDLE_MS=5000

# Optional host-local UI ports.
WACLI_ME_LOCAL_PORT=8787
TUNNEL_UI_PORT=8092
